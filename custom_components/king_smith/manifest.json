{
    "domain": "king_smith",
    "name": "King Smith Walking Pad",
    "bluetooth": [
        {
            "local_name": "KS-BL*"
        },
        {
            "local_name": "KS-HD-Z1D*",
            "connectable": true
        },
        {
            "local_name": "KS-ST-*"
        },
        {
            "local_name": "WalkingPad"
        }
    ],
    "codeowners": [
        "@indiefan"
    ],
    "config_flow": true,
    "dependencies": [
        "bluetooth_adapters"
    ],
    "documentation": "https://github.com/koalexbear/king_smith",
    "integration_type": "device",
    "iot_class": "local_polling",
    "issue_tracker": "https://github.com/koalexbear/king_smith/issues",
    "requirements": [
        "walkingpad-controller==0.5.1",
        "ph4-walkingpad==1.0.2"
    ],
    "version": "0.2.1"
}
